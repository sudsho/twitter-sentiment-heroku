# copy to .env and fill in
# get these from https://developer.twitter.com after your dev account is approved
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# comma separated; overrides configs/default.yaml when set
TRACK_KEYWORDS=python,flask
LANGUAGE=en

# Flask
FLASK_ENV=development
PORT=8000
